ASPNETCORE_URLS=http://localhost:5050;https://localhost:5051
ConnectionStrings__Default=Data Source=ProEventos.db
AppJwtSettings__Audience=ProEventos
AppJwtSettings__Issuer=ProEventos
AppJwtSettings__Expiration=12
AppJwtSettings__RefreshTokenExpiration=30
AppJwtSettings__RefreshTokenType=OneTime
# Leave AppJwtSettings__SecretKey unset so access + refresh tokens use JWKS
# (NetDevPack ValidateRefreshToken always validates against JWKS).
Cors__Origins=http://localhost:5173,http://localhost:3000,http://localhost:4200
